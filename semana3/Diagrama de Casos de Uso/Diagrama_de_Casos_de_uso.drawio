        <mxCell id="M-sNuEwnA89dFTOZBzbz-66" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Diagrama de Casos de Uso&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Este diagrama ilustra as interações dos principais atores, que são os Passageiro e Motorista com as funcionalidades do sistema, enfatizando as restrições e regras de negócio do projeto acadêmico.&lt;/font&gt;&lt;/p&gt;" vertex="1">
