        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Usuario {\n        +String matriculaSSO\n        +String nome\n        +String emailInstitucional\n        +float notaMediaAvaliacoes\n        +loginSSO()\n    }\n\n    class Motorista {\n        +String cnh\n        +oferecerCarona()\n        +aceitarSolicitacao()\n        +recusarSolicitacao()\n        +atualizarStatusViagem()\n        +avaliarPassageiro(Passageiro, int nota)\n    }\n\n    class Passageiro {\n        +buscarCarona()\n        +solicitarVaga()\n        +compartilharLocalizacaoWhatsApp()\n        +avaliarMotorista(Motorista, int nota)\n    }\n\n    class Carona {\n        +int id\n        +String origem\n        +String destino\n        +DateTime dataHora\n        +int vagasTotais\n        +int vagasDisponiveis\n        +float quilometragemTotal\n        +float tetoMaximoRateio\n        +String statusEnum\n        +calcularValorMaximoRateio()\n    }\n\n    class Reserva {\n        +int id\n        +String status\n        +DateTime dataSolicitacao\n        +confirmar()\n        +cancelar()\n    }\n    \n    class HistoricoViagem {\n        +int id\n        +DateTime dataHoraConclusao\n        +salvarRegistro()\n    }\n\n    Usuario &lt;|-- Motorista\n    Usuario &lt;|-- Passageiro\n    Motorista \&quot;1\&quot; -- \&quot;0..*\&quot; Carona : oferece\n    Carona \&quot;1\&quot; *-- \&quot;0..*\&quot; Reserva : possui\n    Passageiro \&quot;1\&quot; -- \&quot;0..*\&quot; Reserva : realiza\n    Carona \&quot;1\&quot; -- \&quot;1\&quot; HistoricoViagem : gera\n    HistoricoViagem \&quot;1\&quot; -- \&quot;1\&quot; Motorista : registra\n    HistoricoViagem \&quot;1\&quot; -- \&quot;1..*\&quot; Passageiro : registra&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9t4Bx-YLzkAcnSE5pjqr-1">
