        <mxCell id="9t4Bx-YLzkAcnSE5pjqr-67" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Diagrama de Classe&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Representa a estrutura de dados do sistema, atendendo ao Histórico (RF-08), cálculo financeiro (RF-03/RF-04) e sistema de notas (RF-09/RF-10).&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="710" x="50" y="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
