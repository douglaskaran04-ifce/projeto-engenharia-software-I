        <mxCell id="EAmCmDjkBU_Ue8y2XBx8-32" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Diagrama de Sequência - Ação 1: Autenticação e Cadastro via SSO Institucional (RF-01, RF-02)&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;O aplicativo utiliza o sistema de autenticação (SSO) da universidade para garantir que apenas alunos e funcionários com vínculo ativo tenham acesso à plataforma.&lt;/font&gt;&lt;/p&gt;" vertex="1">
